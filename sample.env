# Copy to .env and fill in. .env is git-ignored; never commit real keys.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ACCESS_TOKEN_LIFETIME=30

# Database: leave commented for SQLite, or uncomment for PostgreSQL
# database=custom_database
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=futsal
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Khalti sandbox (https://test-admin.khalti.com -> Settings -> Keys -> secret key)
KHALTI_TOKEN=paste-your-sandbox-secret-key-here
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
KHALTI_RETURN_URL=http://localhost:8000/payment/callback/
KHALTI_WEBSITE_URL=http://localhost:8000/

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Booking rules
SLOT_HOLD_SECONDS=600
ADVANCE_PERCENT=30
